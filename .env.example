# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_NAME=ouroboros_orchestrator_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_PORT=3306

# Alternative (Docker/CI compatibility)
# MYSQL_HOST=localhost
# MYSQL_DATABASE=ouroboros_orchestrator_db
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password_here
# MYSQL_PORT=3306

# Database pool (optional)
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=20

# ============================================
# JWT AUTHENTICATION (RS256)
# ============================================
# Generate keys:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXP_SECONDS=900
JWT_REFRESH_TOKEN_EXP_SECONDS=604800
JWT_ISSUER=ouroboros.ai/auth
JWT_AUDIENCE=ouroboros-api

# ============================================
# TWILIO (OTP delivery)
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Optional — use Twilio Verify instead of raw SMS:
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxx

# ============================================
# OTP SETTINGS
# ============================================
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=30
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_MAX_REQUESTS=3

# ============================================
# ALLOWED PHONE COUNTRIES (JSON array, ISO alpha-2)
# ============================================
ALLOWED_COUNTRY_CODES=["SG","IN","VN","ID","MY","US","CA","AU"]

# ============================================
# AGENT SERVICES (URLs for microservices)
# ============================================
STUDENT_PROFILE_SERVICE_URL=http://localhost:8001
PROGRAM_DISCOVERY_SERVICE_URL=http://localhost:8002
SCHOLARSHIP_DISCOVERY_SERVICE_URL=http://localhost:8003
ELIGIBILITY_SERVICE_URL=http://localhost:8004
APPLICATION_SUPPORT_SERVICE_URL=http://localhost:8005

# ============================================
# INTER-SERVICE AUTHENTICATION
# ============================================
X_SERVICE_TOKEN=your_shared_secret_token_min_32_chars

# ============================================
# HTTP CLIENT SETTINGS
# ============================================
AGENT_CALL_TIMEOUT=30
AGENT_CALL_RETRIES=2
AGENT_CALL_BACKOFF_FACTOR=1.0

# ============================================
# APPLICATION SETTINGS
# ============================================
LOG_LEVEL=INFO
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# ============================================
# DOCKER SETTINGS
# ============================================
RUN_STARTUP_SCRIPTS=true
SEED_DATABASE=true
DOCKER_MYSQL_PORT=3307
