{
  "version": "v1-draft",
  "description": "Intent-to-agent capability map and profile field policy used by orchestrator gating.",
  "base_required_fields": [
    "current_degree_level",
    "target_degree_level",
    "gpa",
    "gpa_scale",
    "intended_field_of_study"
  ],
  "intents": {
    "profile_completion": {
      "agent": "student-profile",
      "confidence_threshold": 0.7,
      "required_fields": [],
      "optional_fields": [
        "target_study_country",
        "enrollment_timeline",
        "funding_source"
      ],
      "fallback": {
        "type": "ask_required_profile_fields"
      }
    },
    "scholarship_search": {
      "agent": "scholarship-discovery",
      "confidence_threshold": 0.7,
      "required_fields": ["target_study_country"],
      "optional_fields": ["enrollment_timeline", "funding_source"],
      "fallback": {
        "type": "ask_missing_required_fields"
      }
    },
    "program_discovery": {
      "agent": "program-discovery",
      "confidence_threshold": 0.7,
      "required_fields": [],
      "optional_fields": [
        "target_study_country",
        "enrollment_timeline",
        "funding_source"
      ],
      "fallback": {
        "type": "ask_missing_required_fields"
      }
    },
    "eligibility_check": {
      "agent": "eligibility-engine",
      "confidence_threshold": 0.7,
      "required_fields": ["target_study_country"],
      "optional_fields": ["enrollment_timeline", "funding_source"],
      "fallback": {
        "type": "ask_missing_required_fields"
      }
    },
    "application_planning": {
      "agent": "application-support",
      "confidence_threshold": 0.7,
      "required_fields": ["enrollment_timeline"],
      "optional_fields": ["target_study_country", "funding_source"],
      "fallback": {
        "type": "ask_missing_required_fields"
      }
    },
    "apply_to_named_school": {
      "agent": "program-discovery",
      "next_agent": "application-support",
      "confidence_threshold": 0.75,
      "required_fields": [],
      "optional_fields": [
        "target_study_country",
        "enrollment_timeline",
        "funding_source"
      ],
      "fallback": {
        "type": "infer_country_from_school_or_ask"
      }
    },
    "out_of_scope": {
      "agent": null,
      "confidence_threshold": 1.0,
      "required_fields": [],
      "optional_fields": [],
      "fallback": {
        "type": "boundary_message",
        "suggest_intents": [
          "scholarship_search",
          "program_discovery",
          "application_planning"
        ]
      }
    }
  }
}
